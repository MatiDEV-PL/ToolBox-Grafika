# Virtual environment
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
# katalogi tworzone przez tmp_path w testach
pytest-of-*/

# Packaging
*.egg-info/
dist/
build/

# Lockfile - biblioteka, nie aplikacja: nie przypinamy wersji zależności
# (dla aplikacji uv.lock powinien być commitowany)
uv.lock
