def jako_parametryka(self) -> Parametryka:\
        """Zamiana na zapis z punktem i wektorem bo tak si\uc0\u281  \u322 atwiej liczy."""\
        return Parametryka(\
            self.poczatek.x,\
            self.poczatek.y,\
            self.koniec.x - self.poczatek.x,\
            self.koniec.y - self.poczatek.y,\
            kolor=self.kolor,\
        )\
\
